# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=rmsb_db

# ── DB connection (local dev only — Docker injects these automatically) ───
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=password
DB_NAME=rmsb_db

# ── Admin access ──────────────────────────────────────────
# Gateway: used to assign Administrator role server-side
ADMIN_EMAILS=your.email@kloudius.com
# Frontend: used to show admin UI before gateway confirms role
VITE_ADMIN_EMAILS=your.email@kloudius.com

# ── Frontend ──────────────────────────────────────────────
VITE_API_GATEWAY_URL=http://localhost:8080

# ── GitHub — auto-deploy when a service is activated ──────
# Fine-grained PAT: Contents read+write on multiservice_process_dashboard
DEPLOY_TOKEN=
GITHUB_REPO=Kloudius/multiservice_process_dashboard
# GitHub org/user that owns the GHCR images (must be lowercase)
GHCR_OWNER=kloudius
