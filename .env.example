# ── Frontend ──────────────────────────────────────────────
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_APP_NAME=MultiService Process Dashboard

# ── Jenkins / GHCR ───────────────────────────────────────
GHCR_OWNER=your-org
TAG=latest
