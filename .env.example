# ── PostgreSQL (shared instance) ─────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=rmsb_db

# ── DB connection (used by service APIs, matches above) ───
# In Docker these are passed automatically via docker-compose.
# For local dev (running services with npm run dev), copy these
# into a .env file inside each service folder.
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=password
DB_NAME=rmsb_db

# ── API Gateway ───────────────────────────────────────────
S1_SERVICE_URL=http://s1-api:3001
S2_SERVICE_URL=http://s2-api:3002

# ── Frontend ──────────────────────────────────────────────
VITE_API_GATEWAY_URL=http://localhost:8080

# ── Admin emails (comma-separated, Microsoft login) ───────
# Users with these emails get Administrator role on M365 login
VITE_ADMIN_EMAILS=saira.nawaz@kloudius.com
